# === §0A — REQUIRED for first run (README) ===
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
API_PORT=4000
PORT=4000

# auth (clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# postgres (neon)
DATABASE_URL=

# openai
OPENAI_API_KEY=

# vectors (pinecone)
PINECONE_API_KEY=
PINECONE_INDEX=

# anthropic (or ANSWER_MODEL=openai)
ANTHROPIC_API_KEY=

# jobs (inngest) — local dev server, no cloud keys
INNGEST_DEV=1

# === §0B — OPTIONAL: full stack / perch graph (README table) ===

# ANSWER_MODEL=openai

# redis (upstash)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# realtime (pusher)
# PUSHER_APP_ID=
# PUSHER_KEY=
# PUSHER_SECRET=
# PUSHER_CLUSTER=us2
# NEXT_PUBLIC_PUSHER_KEY=
# NEXT_PUBLIC_PUSHER_CLUSTER=us2

# billing (stripe)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=

# email (resend)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=onboarding@resend.dev

# errors (sentry)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# analytics (posthog)
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# logs (logtail / Better Stack)
# LOGTAIL_SOURCE_TOKEN=

# traces (langsmith)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=perch-brief

# media (cloudinary)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# queue (upstash-qstash)
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=

# metrics (datadog)
# DD_API_KEY=
# DD_SITE=us5.datadoghq.com

# Perch-only (hosted status / deploy — not required for local app)
# NEON_API_KEY=
# VERCEL_TOKEN=
# RAILWAY_TOKEN=
# GITHUB_TOKEN=
